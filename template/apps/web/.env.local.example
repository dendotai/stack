# Build-time env for Vite (gitignored as .env.local). Copy to apps/web/.env.local.
# VITE_CONVEX_URL is embedded into the client bundle, so it must be your DEV
# deployment URL for local builds. CI supplies it per-environment in deploy.yml.
VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud

# Optional: the dev server port for a second checkout of this repo (an agent
# worktree sets it). With PORT set, `bun dev` serves http://localhost:<PORT>,
# on localhost only, and skips the devsite host and its HMR-through-proxy
# setup; the screenshot scripts target that origin by default. Leave it unset
# in the main checkout, which keeps the port from package.json#devSite. A PORT
# in the process environment wins over this file.
# PORT=3012
