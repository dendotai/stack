# Build-time env for Vite (gitignored as .env.local). Copy to apps/web/.env.local.
# VITE_CONVEX_URL is embedded into the client bundle, so it must be your DEV
# deployment URL for local builds. CI supplies it per-environment in deploy.yml.
VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud

# Only for a local Convex backend, which serves HTTP actions on its own port.
# Against a cloud deployment the auth proxy derives the site URL from the line
# above, so leave this unset. `convex dev` writes both values to
# packages/api/.env.local — copy them from there.
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
