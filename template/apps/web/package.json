{
  "name": "@stack/web",
  "private": true,
  "type": "module",
  "devSite": {
    "host": "stack.internal"
  },
  "scripts": {
    "dev": "vite dev",
    "generate": "tsr generate",
    "build": "bun run generate && vite build",
    "preview": "vite preview",
    "test": "bun run generate && vitest run",
    "typecheck": "bun run generate && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "auth:login": "bun scripts/auth-login.mjs",
    "screenshots": "bun scripts/screenshot.mjs",
    "deploy": "bun run build && wrangler deploy --env prod",
    "deploy:dev": "bun run build && wrangler deploy --env dev",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/react-query": "0.1.0",
    "@fontsource-variable/geist": "5.3.0",
    "@stack/api": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.1",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-ssr-query": "1.166.12",
    "@tanstack/react-start": "1.167.64",
    "@tanstack/router-plugin": "1.168.18",
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "convex": "1.42.0",
    "lucide-react": "1.56.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.3",
    "@cloudflare/workers-types": "4.20260625.1",
    "@den-ai/devsite": "0.1.0",
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/router-cli": "1.167.35",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
