{
  "environments": ["dev", "prod"],
  "sections": [
    {
      "label": "cloudflare",
      "fields": [
        {
          "label": "account-id",
          "secret": false,
          "for": "GitHub variable CLOUDFLARE_ACCOUNT_ID (same value in both items)"
        },
        {
          "label": "api-token",
          "secret": true,
          "for": "GitHub secret CLOUDFLARE_API_TOKEN (same value in both items)"
        }
      ]
    },
    {
      "label": "convex",
      "fields": [
        { "label": "deployment", "secret": false, "for": "the Convex deployment name" },
        { "label": "url", "secret": false, "for": "GitHub variable CONVEX_URL" },
        { "label": "deploy-key", "secret": true, "for": "GitHub secret CONVEX_DEPLOY_KEY" },
        {
          "label": "auth-secret",
          "secret": true,
          "generate": true,
          "for": "Convex env BETTER_AUTH_SECRET"
        }
      ]
    },
    {
      "label": "google",
      "fields": [
        { "label": "client-id", "secret": false, "for": "Convex env GOOGLE_CLIENT_ID" },
        { "label": "client-secret", "secret": true, "for": "Convex env GOOGLE_CLIENT_SECRET" }
      ]
    },
    {
      "label": "app",
      "fields": [
        {
          "label": "site-url",
          "secret": false,
          "value": "https://{domain}",
          "for": "Convex env SITE_URL"
        }
      ]
    }
  ]
}
